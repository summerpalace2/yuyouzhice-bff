# DEPRECATED TEMPLATE — not loaded by local runtime or importer.
# Canonical local configuration is D:\\scenic-guide\\ai\\.env.example;
# the real file is D:\\scenic-guide\\ai\\.env. Retained only for migration reference.
# Never copy real values automatically and never commit secrets.

# ===== REQUIRED_LOCAL_CORE =====
# The only values needed to start the local Web BFF + Java Core path.
# JWT_SECRET and YUYOUZHICE_AUTH_SECRET are generated locally on first initialization.
JWT_SECRET=CHANGE_ME
YUYOUZHICE_AUTH_SECRET=CHANGE_ME
CORE_BACKEND_URL=http://127.0.0.1:8080
YUYOUZHICE_JAVA_TIMEOUT_MS=4000

# ===== OPTIONAL_FEATURE =====
# Enable/configure only when the corresponding local feature is used.
# These do not block the core Web + Java startup when left empty or unchanged.
AMAP_ANDROID_KEY=CHANGE_ME
YUYOUZHICE_MEMORY=1
YUYOUZHICE_REVOKE_STORE=memory
KNOWLEDGE_DB_TYPE=sqlite
KNOWLEDGE_DB_URL=
KNOWLEDGE_DB_USERNAME=
KNOWLEDGE_DB_PASSWORD=
KNOWLEDGE_UPLOAD_DIR=uploads/knowledge

# ===== PROVIDER_SPECIFIC =====
# Model, map, embedding, rerank, and speech providers are opt-in credentials.
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AMAP_WEB_SERVICE_KEY=CHANGE_ME
AMAP_WEB_SERVICE_BASE_URL=https://restapi.amap.com
AMAP_WEB_SERVICE_TIMEOUT_MS=6000
AMAP_WEB_SERVICE_ROUTE_TIMEOUT_MS=6500
AMAP_WEB_SERVICE_MAX_CONCURRENCY=2
AMAP_WEB_JS_KEY=CHANGE_ME
AMAP_WEB_JS_SECURITY_CODE=CHANGE_ME
DASHSCOPE_API_KEY=CHANGE_ME
BAILIAN_API_KEY=CHANGE_ME
BAILIAN_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
BAIDU_API_KEY=CHANGE_ME
BAIDU_SECRET_KEY=CHANGE_ME
YUYOUZHICE_ENV_FILE=
YUYOUZHICE_EMBEDDING_PROVIDER=dashscope
YUYOUZHICE_EMBEDDING_URL=
DASHSCOPE_EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
YUYOUZHICE_EMBEDDING_API_KEY=
YUYOUZHICE_EMBEDDING_MODEL=text-embedding-v2
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2
BAILIAN_EMBEDDING_MODEL=text-embedding-v2
OPENAI_EMBEDDING_MODEL=
YUYOUZHICE_EMBEDDING_DIMENSION=1536
DASHSCOPE_EMBEDDING_DIMENSION=1536
YUYOUZHICE_EMBEDDING_BATCH_SIZE=10
YUYOUZHICE_IMPORT_TIMEOUT_MS=30000
YUYOUZHICE_CORPUS_FILE=
YUYOUZHICE_SOURCE_REGISTER_FILE=
YUYOUZHICE_EMBEDDING_MANIFEST_FILE=

# ===== INFRA_OPTIONAL =====
# Local Redis/Qdrant are not required for the default in-memory/SQLite path.
# Qdrant importer uses REST (normally 6333); Java's optional client uses gRPC (6334).
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_API_KEY=
QDRANT_PRODUCTION_V2_COLLECTION=scenic_guide_production_v2
QDRANT_PRODUCTION_V2_AUTO_CREATE_INDEXES=false
YUYOUZHICE_QDRANT_URL=
QDRANT_URL=
YUYOUZHICE_QDRANT_SCHEME=http
QDRANT_SCHEME=http
QDRANT_PROTOCOL=http
YUYOUZHICE_QDRANT_API_KEY=
YUYOUZHICE_VECTOR_STORE_COLLECTION=scenic_guide_production_v2
QDRANT_COLLECTION=scenic_guide_production_v2
YUYOUZHICE_REDIS_URL=redis://127.0.0.1:6379
YUYOUZHICE_REDIS_HOST=127.0.0.1
YUYOUZHICE_REDIS_PORT=6379
YUYOUZHICE_REDIS_PASSWORD=
YUYOUZHICE_REDIS_DATABASE=0
YUYOUZHICE_REDIS_SSL=false
YUYOUZHICE_REDIS_TIMEOUT_MS=1200
YUYOUZHICE_REDIS_KEY_PREFIX=yuyouzhice:revoked:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SSL=false
REDIS_TIMEOUT_MS=5000
JWT_REVOCATION_REDIS_ENABLED=false

# ===== PRODUCTION_ONLY =====
# Keep empty/disabled on a normal workstation. Use a secret manager in production.
DATABASE_URL=
POSTGRES_URL=
POSTGRES_JDBC_URL=
POSTGRES_URI=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
ADMIN_BOOTSTRAP_MODE=disabled
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ===== COMPATIBILITY_ALIASES =====
# Accepted temporarily by loaders; prefer the canonical names above.
# AMAP_KEY=CHANGE_ME
# AMAP_JS_KEY=CHANGE_ME
# AMAP_JS_SECURITY_KEY=CHANGE_ME
# YUYOUZHICE_JAVA_CORE_URL=http://127.0.0.1:8080
